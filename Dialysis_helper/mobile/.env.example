# Copia este archivo como .env.local y ajusta los valores. Todos son opcionales.

# URL del backend. Todavía no se usa: auth, invitaciones y consentimiento van con un backend simulado.
#   Emulador de Android: http://10.0.2.2:8000
#   Simulador de iOS:    http://localhost:8000
#   Teléfono físico:     http://<IP-de-tu-computadora>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Pacientes sintéticos (SIS-RF-019). Solo en desarrollo: no existen en el build de producción.
# La misma semilla genera siempre los mismos pacientes. La cantidad incluye a María (máx. 200).
EXPO_PUBLIC_SYNTHETIC_SEED=2026
EXPO_PUBLIC_SYNTHETIC_COUNT=8
