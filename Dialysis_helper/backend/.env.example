# Copia este archivo a ".env" (make setup lo hace por ti). NUNCA subas el ".env".
# Todos los valores de aqui son de desarrollo y son falsos.

DJANGO_SECRET_KEY=cambia-esto-en-tu-maquina-clave-solo-de-desarrollo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Con Docker Compose el servidor de base de datos se llama "db".
# Si corres Django sin Docker, cambia "db" por "localhost".
DATABASE_URL=postgres://dphogar:dphogar_dev@db:5432/dphogar

# Origenes de la web en desarrollo (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
